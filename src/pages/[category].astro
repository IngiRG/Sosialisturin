---
import Base from '../layouts/Base.astro'; import PostCard from '../components/PostCard.astro'; import {getCollection} from 'astro:content';
export function getStaticPaths(){return ['tidindi','astodi','poddvarp'].map(category=>({params:{category}}));}
const map: Record<string,'Tíðindi'|'Ástøði'|'Poddvarp'>={tidindi:'Tíðindi',astodi:'Ástøði',poddvarp:'Poddvarp'}; const key=Astro.params.category ?? 'tidindi'; const label=map[key] ?? 'Tíðindi'; const posts=(await getCollection('posts',p=>p.data.category===label)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()); const base=import.meta.env.BASE_URL;
---
<Base title={label}><header class="page-head"><h1>{label}</h1>{label==='Ástøði'&&<nav class="subnav" aria-label="Ástøði undirpartar"><a href={base+'astodi/'}>Alt</a><a href="#lesarabrov">Lesarabrøv</a></nav>}</header>{label==='Ástøði'&&posts.some(p=>p.data.section==='Lesarabrøv')&&<section class="section" id="lesarabrov"><div class="section-head"><h2>Lesarabrøv</h2></div><div class="grid three">{posts.filter(p=>p.data.section==='Lesarabrøv').map(p=><PostCard post={p}/>)}</div></section>}<section class="section"><div class="grid three">{posts.filter(p=>label!=='Ástøði'||p.data.section!=='Lesarabrøv').map(p=><PostCard post={p}/>)}</div></section></Base>