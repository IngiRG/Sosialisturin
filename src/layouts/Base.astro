---
import '../styles/global.css';
const {title='Sosialisturin',description='Tín kelda til føroysk sosialistisk tíðindi, greiningar og ástøði, alt á einum staði.',socialImagePath='Social-preview.png'}=Astro.props; const base=import.meta.env.BASE_URL; const socialImage=new URL(base+socialImagePath,Astro.site); const nav=[['Tíðindi','tidindi'],['Ástøði','astodi'],['Lesarabrøv','lesarabrov'],['Filmar','filmar'],['Poddvarp','poddvarp'],['Um','um-okkum'],['Lesilisti','lesilisti'],['Ver við','vervid']];
---
<!doctype html><html lang="fo"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width"><meta name="description" content={description}><meta name="theme-color" content="#9d1c20"><script is:inline>try{const saved=localStorage.getItem("sosialisturin-theme");document.documentElement.dataset.theme=saved==="dark"||saved!=="light"&&window.matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light"}catch(e){}</script><meta property="og:type" content="website"><meta property="og:site_name" content="Sosialisturin"><meta property="og:title" content={title==='Sosialisturin'?title:`${title} — Sosialisturin`}><meta property="og:description" content={description}><meta property="og:image" content={socialImage}><meta property="og:image:type" content="image/png"><meta name="twitter:card" content="summary"><meta name="twitter:title" content={title==='Sosialisturin'?title:`${title} — Sosialisturin`}><meta name="twitter:description" content={description}><meta name="twitter:image" content={socialImage}><title>{title==='Sosialisturin'?title:`${title} — Sosialisturin`}</title><link rel="icon" href={base+'favicon.svg'}><link rel="alternate" type="application/rss+xml" title="Sosialisturin RSS" href={base+'rss.xml'}></head><body><div class="topline"></div><header class="site-header"><a class="brand" href={base}>SOSIALISTURIN<span>.</span></a><nav>{nav.map(([label,path])=><a href={base+path+'/'}>{label}</a>)}</nav><button class="theme-toggle" type="button" aria-label="Skift litbrigdi" title="Skift millum ljóst og myrkt" aria-pressed="false"><span class="theme-icon" aria-hidden="true"><svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5 8.5 8.5 0 1 0 20.5 14.2Z"/></svg><svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></svg></span></button></header><main><slot /></main><footer><div><a class="brand footer-brand" href={base}>SOSIALISTURIN<span>.</span></a></div><div>{nav.map(([label,path])=><a href={base+path+'/'}>{label}</a>)}</div><div><a href={base+'rss.xml'}>RSS</a><a href="mailto:ritstjorn@sosialistur.info">ritstjorn@sosialistur.info</a><span>Ábyrgdarblaðstjóri: Ingi Reinert Gásadal</span></div></footer><script is:inline>!function(){const b=document.querySelector(".theme-toggle");if(!b)return;const sync=()=>{const dark=document.documentElement.dataset.theme==="dark";b.setAttribute("aria-pressed",String(dark));b.setAttribute("aria-label",dark?"Skift til ljóst":"Skift til myrkt")};sync();b.addEventListener("click",()=>{const next=document.documentElement.dataset.theme==="dark"?"light":"dark";document.documentElement.dataset.theme=next;try{localStorage.setItem("sosialisturin-theme",next)}catch(e){}sync()})}();</script><script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "73cc18be256d4a308b5dc16dcf3f5e97"}'></script></body></html>
