---
import Base from '../layouts/Base.astro'; import PostCard from '../components/PostCard.astro'; import {getCollection} from 'astro:content';
const posts=(await getCollection('posts')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()); const hero=posts.find(p=>p.data.featured)||posts[0]; const rest=posts.filter(p=>p.id!==hero?.id); const base=import.meta.env.BASE_URL;
---
<Base><section class="home-intro"><h1>Tín kelda til føroysk sosialistisk tíðindi, greiningar og ástøði, alt á einum staði.</h1></section>{hero&&<section class="hero"><div class="hero-copy"><div class="eyebrow">{hero.data.category}{hero.data.section&&<> · {hero.data.section}</>}</div><h1><a href={base+'grein/'+hero.id.replace(/\.(md|mdx)$/,'')+'/'}>{hero.data.title}</a></h1><p>{hero.data.description}</p><div class="meta">{hero.data.author}</div></div><a class="hero-art" href={base+'grein/'+hero.id.replace(/\.(md|mdx)$/,'')+'/'}><div class="art-placeholder"><span>S</span><i>01</i></div></a></section>}{rest.length>0&&<section class="section"><div class="section-head"><h2>Seinastu greinar</h2></div><div class="grid three">{rest.slice(0,6).map(p=><PostCard post={p}/>)}</div></section>}</Base>