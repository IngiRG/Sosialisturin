---
import Base from '../layouts/Base.astro'; import PostCard from '../components/PostCard.astro'; import {getCollection} from 'astro:content';
export function getStaticPaths(){return ['tidindi','astodi','lesarabrov','poddvarp'].map(category=>({params:{category}}));}
import early from '../data/early-access.json';
const map: Record<string,'Tíðindi'|'Ástøði'|'Lesarabrøv'|'Poddvarp'>={tidindi:'Tíðindi',astodi:'Ástøði',lesarabrov:'Lesarabrøv',poddvarp:'Poddvarp'}; const key=Astro.params.category ?? 'tidindi'; const label=map[key] ?? 'Tíðindi'; const all=await getCollection('posts'); const posts=all.filter(p=>label==='Lesarabrøv'?p.data.category==='Ástøði'&&p.data.section==='Lesarabrøv':label==='Ástøði'?p.data.category==='Ástøði'&&p.data.section!=='Lesarabrøv':p.data.category===label).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()); const base=import.meta.env.BASE_URL; const previews=early.filter(p=>new Date(p.releaseAt).getTime()>Date.now()&&(label==='Lesarabrøv'?p.category==='Ástøði'&&p.section==='Lesarabrøv':label==='Ástøði'?p.category==='Ástøði'&&p.section!=='Lesarabrøv':p.category===label)); const items=[...posts.map(post=>({kind:'post',post,date:post.data.date.valueOf()})),...previews.map(preview=>({kind:'preview',preview,date:new Date(preview.releaseAt).getTime()}))].sort((a,b)=>b.date-a.date);
---
<Base title={label}><header class="page-head"><h1>{label}</h1></header><section class="section"><div class="grid three">{items.map(item=>item.kind==='post'?<PostCard post={item.post}/>:<article class="card"><div class="eyebrow">{item.preview.category} · Fyrsti lesari</div><h2><a href={'/grein/'+item.preview.slug+'/'}>{item.preview.title}</a></h2><p>{item.preview.description}</p><div class="meta">Kemur skjótt</div></article>)}</div></section></Base>