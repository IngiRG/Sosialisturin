---
import Base from '../layouts/Base.astro'; import PostCard from '../components/PostCard.astro'; import {getCollection} from 'astro:content';
import earlyData from '../data/early-access.json'; const early = earlyData as Array<{slug:string;title:string;description:string;releaseAt:string;patreonUrl:string;category:string;section?:string}>;
const previews=early.filter(item=>new Date(item.releaseAt).getTime()>Date.now());
const posts=(await getCollection('posts')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()); const hero=posts.find(p=>p.data.featured)||posts[0]; const rest=posts.filter(p=>p.id!==hero?.id); const base=import.meta.env.BASE_URL; const items=[...rest.map(post=>({kind:'post' as const,post,date:post.data.date.valueOf()})),...previews.map(preview=>({kind:'preview' as const,preview,date:new Date(preview.releaseAt).getTime()}))].sort((a,b)=>b.date-a.date);
---
<Base><section class="home-intro"><h1>Tín kelda til føroysk sosialistisk tíðindi, greiningar og ástøði, alt á einum staði.</h1></section>{hero&&<section class="hero"><div class="hero-copy"><div class="eyebrow">{hero.data.category}{hero.data.section&&<> · {hero.data.section}</>}</div><h1><a href={base+'grein/'+hero.id.replace(/\.(md|mdx)$/,'')+'/'}>{hero.data.title}</a></h1><p>{hero.data.description}</p><div class="meta">{hero.data.author}</div></div><a class="hero-art" href={base+'grein/'+hero.id.replace(/\.(md|mdx)$/,'')+'/'}><div class="art-placeholder"><span>S</span><i>01</i></div></a></section>}{items.length>0&&<section class="section"><div class="section-head"><h2>Seinastu greinar</h2></div><div class="grid three">{items.slice(0,6).map(item=>item.kind==='post'?<PostCard post={item.post}/>:<article class="card"><div class="eyebrow">{item.preview.section||item.preview.category}</div><div class="preview-lock" aria-label="Læst grein" title="Læst grein"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg></div><h2><a href={'/grein/'+item.preview.slug+'/'}>{item.preview.title}</a></h2><p>{item.preview.description}</p></article>)}</div></section>}</Base>
<style>.preview-lock{display:inline-flex;align-items:center;justify-content:center;background:#a51d25;color:#fff;border-radius:0;width:42px;height:42px;margin:.75rem 0 .4rem;box-shadow:0 3px 9px rgba(100,0,0,.18)}</style>
