---
import '../styles/global.css';
const {title='Sosialisturin',description='Tín kelda til føroysk sosialistisk tíðindi, greiningar og ástøði, alt á einum staði.'}=Astro.props; const base=import.meta.env.BASE_URL; const socialImage=new URL(base+'favicon.svg',Astro.site); const nav=[['Tíðindi','tidindi'],['Ástøði','astodi'],['Lesarabrøv','lesarabrov'],['Filmar','filmar'],['Poddvarp','poddvarp'],['Um','um-okkum'],['Lesilisti','lesilisti'],['Stuðlað','studlad']];
---
<!doctype html><html lang="fo"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width"><meta name="description" content={description}><meta name="theme-color" content="#9d1c20"><meta property="og:type" content="website"><meta property="og:site_name" content="Sosialisturin"><meta property="og:title" content={title==='Sosialisturin'?title:`${title} — Sosialisturin`}><meta property="og:description" content={description}><meta property="og:image" content={socialImage}><meta name="twitter:card" content="summary"><meta name="twitter:title" content={title==='Sosialisturin'?title:`${title} — Sosialisturin`}><meta name="twitter:description" content={description}><meta name="twitter:image" content={socialImage}><title>{title==='Sosialisturin'?title:`${title} — Sosialisturin`}</title><link rel="icon" href={base+'favicon.svg'}><link rel="alternate" type="application/rss+xml" title="Sosialisturin RSS" href={base+'rss.xml'}></head><body><div class="topline"></div><header class="site-header"><a class="brand" href={base}>SOSIALISTURIN<span>.</span></a><nav>{nav.map(([label,path])=><a href={base+path+'/'}>{label}</a>)}</nav><a class="rss" href={base+'rss.xml'}>RSS</a></header><main><slot /></main><footer><div><a class="brand footer-brand" href={base}>SOSIALISTURIN<span>.</span></a></div><div>{nav.map(([label,path])=><a href={base+path+'/'}>{label}</a>)}</div><div><a href={base+'rss.xml'}>RSS</a><a href="mailto:ritstjorn@sosialistur.info">ritstjorn@sosialistur.info</a></div></footer></body></html>
