---
import Base from '../../layouts/Base.astro'; import earlyData from '../../data/early-access.json'; const early = earlyData as Array<{slug:string;title:string;description:string;releaseAt:string;patreonUrl:string;category:string;section?:string}>; import {getCollection,render} from 'astro:content';
export async function getStaticPaths(){const early = (await import('../../data/early-access.json')).default as Array<{slug:string;title:string;description:string;releaseAt:string;patreonUrl:string;category:string;section?:string}>; const posts=await getCollection('posts');return [...posts.map(post=>({params:{slug:post.id.replace(/\.(md|mdx)$/,'')},props:{post}})),...early.filter(item=>!posts.some(p=>p.id.replace(/\.(md|mdx)$/,'')===item.slug)).map(item=>({params:{slug:item.slug},props:{preview:item}}))];} const {post,preview}=Astro.props; const rendered=post?await render(post):null; const Content=rendered?.Content; const d=post?.data ?? {title:'',description:'',date:new Date(),section:undefined,category:'Ástøði',author:'',duration:undefined,mediaUrl:undefined}; const date=d?.date.toLocaleDateString('fo-FO',{day:'numeric',month:'long',year:'numeric'}); const base=import.meta.env.BASE_URL; const path=d?.section==='Lesarabrøv'?'lesarabrov':d?.category==='Tíðindi'?'tidindi':d?.category==='Ástøði'?'astodi':'poddvarp'; const backLabel=d?.section==='Lesarabrøv'?'Lesarabrøv':d?.category;
---
<Base title={d?.title||preview?.title||'Grein'} description={d?.description||preview?.description||''}>{preview?<article class="article"><a class="back" href="/">← Forsíða</a><header><div class="eyebrow">{preview?.section||preview?.category}</div><h1>{preview?.title}</h1></header><div class="prose"><p>henda greinin verður útgivin um:</p><div id="countdown" class="countdown-blocks" data-release={preview?.releaseAt} role="timer" aria-label="Tíð til útgávu"><div class="countdown-unit"><strong data-unit="days">--</strong><span>dagar</span></div><div class="countdown-unit"><strong data-unit="hours">--</strong><span>tímar</span></div><div class="countdown-unit"><strong data-unit="minutes">--</strong><span>minuttir</span></div></div></div></article>:<article class="article"><a class="back" href={base+path+'/'}>← {backLabel}</a><header><div class="eyebrow">{d.category}{d.section&&<> · {d.section}</>}</div><h1>{d.title}</h1><p class="dek">{d.description}</p><div class="byline"><strong>{d.author}</strong><span>{date}</span>{d.duration&&<span>{d.duration}</span>}</div></header>{d.mediaUrl&&d.category==='Poddvarp'&&<audio controls src={d.mediaUrl}></audio>}<div class="prose">{Content&&<Content />}</div><footer class="article-end"><span>S</span><p>Sosialisturin</p></footer></article>}</Base><style>
.countdown-blocks{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(7px,2vw,16px);margin:1.5rem 0 2rem;max-width:680px}
.countdown-unit{background:linear-gradient(155deg,#bc242b,#861419);color:#fff;border:1px solid #751014;border-radius:0;padding:clamp(12px,3vw,25px) 6px;text-align:center;box-shadow:0 6px 16px rgba(102,15,20,.16);font-variant-numeric:tabular-nums}
.countdown-unit strong{display:block;font-size:clamp(1.55rem,5vw,3.2rem);line-height:1.15;font-weight:800;letter-spacing:-.04em}
.countdown-unit span{display:block;font-size:clamp(.7rem,1.6vw,.92rem);margin-top:8px;letter-spacing:.025em}
@media(max-width:370px){.countdown-blocks{gap:5px}.countdown-unit{padding:13px 3px}}
</style>
<script>
const node=document.getElementById('countdown');
if(node){
 const target=new Date(node.dataset.release||'').getTime();
 const fields={days:node.querySelector('[data-unit="days"]'),hours:node.querySelector('[data-unit="hours"]'),minutes:node.querySelector('[data-unit="minutes"]')};
 const tick=()=>{
  const remaining=Math.max(0,Math.floor((target-Date.now())/1000));
  const values={days:Math.floor(remaining/86400),hours:Math.floor(remaining%86400/3600),minutes:Math.floor(remaining%3600/60)};
  for(const key of ['days','hours','minutes'] as const){const field=fields[key];if(field)field.textContent=String(values[key]).padStart(2,'0');}
 };
 tick();setInterval(tick,60000);
}
</script>