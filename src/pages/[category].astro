---
import Base from '../layouts/Base.astro'; import PostCard from '../components/PostCard.astro'; import {getCollection} from 'astro:content';
export function getStaticPaths(){return ['tidindi','astodi','lesarabrov','poddvarp'].map(category=>({params:{category}}));}
import earlyData from '../data/early-access.json'; const early = earlyData as Array<{slug:string;title:string;description:string;releaseAt:string;patreonUrl:string;category:string;section?:string}>;
const map: Record<string,'Tíðindi'|'Ástøði'|'Lesarabrøv'|'Poddvarp'>={tidindi:'Tíðindi',astodi:'Ástøði',lesarabrov:'Lesarabrøv',poddvarp:'Poddvarp'}; const key=Astro.params.category ?? 'tidindi'; const label=map[key] ?? 'Tíðindi'; const all=await getCollection('posts'); const posts=all.filter(p=>label==='Lesarabrøv'?p.data.category==='Ástøði'&&p.data.section==='Lesarabrøv':label==='Ástøði'?p.data.category==='Ástøði'&&p.data.section!=='Lesarabrøv':p.data.category===label).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()); const base=import.meta.env.BASE_URL; const previews=early.filter(p=>new Date(p.releaseAt).getTime()>Date.now()&&(label==='Lesarabrøv'?p.category==='Ástøði'&&p.section==='Lesarabrøv':label==='Ástøði'?p.category==='Ástøði'&&p.section!=='Lesarabrøv':p.category===label)); const items=[...posts.map(post=>({kind:'post' as const,post,date:post.data.date.valueOf()})),...previews.map(preview=>({kind:'preview' as const,preview,date:new Date(preview.releaseAt).getTime()}))].sort((a,b)=>b.date-a.date);
---
<Base title={label}><header class="page-head"><h1>{label}</h1></header><section class="section"><div class="grid three">{items.map(item=>item.kind==='post'?<PostCard post={item.post}/>:<article class="card"><a class="card-art" href={base+'grein/'+item.preview.slug+'/'} aria-label={'Patreon: '+item.preview.title}><div class="art-placeholder"><span>S</span></div><span class="preview-clock-lock" aria-hidden="true"><span class="preview-diagonal-banner"><svg class="preview-clock-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 6v6l4 2"/></svg><span class="preview-banner-label">PATREON</span><svg class="preview-padlock-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="10" width="14" height="11" rx="1"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/><path d="M12 14v3"/></svg></span></span></a><div class="eyebrow">{item.preview.section||item.preview.category}</div><h2><a href={base+'grein/'+item.preview.slug+'/'}>{item.preview.title}</a></h2><p>{item.preview.description}</p></article>)}</div></section></Base>
<style>.preview-clock-lock{position:absolute;inset:0;z-index:2;overflow:hidden;pointer-events:none}.preview-diagonal-banner{position:absolute;left:50%;top:50%;width:145%;height:76px;transform:translate(-50%,-50%) rotate(-29deg);display:flex;align-items:center;justify-content:center;gap:15px;background:#f4f0e7;color:#9d1c20;border-top:3px solid #9d1c20;border-bottom:3px solid #9d1c20;white-space:nowrap;box-shadow:0 2px 0 rgba(0,0,0,.08)}.preview-diagonal-banner svg{width:42px;height:42px;flex:none}.preview-banner-label{font:900 clamp(19px,2.2vw,29px)/1 Arial,sans-serif;letter-spacing:1px}@media(max-width:600px){.preview-diagonal-banner{height:72px;gap:12px}.preview-diagonal-banner svg{width:36px;height:36px}.preview-banner-label{font-size:25px}}</style>
