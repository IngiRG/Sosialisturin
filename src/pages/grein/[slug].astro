---
import Base from '../../layouts/Base.astro';
import early from '../../data/early-access.json';
export function getStaticPaths() {
  return early.map(item=>({params:{slug:item.slug},props:{item}}));
}
const {item}=Astro.props;
const date=new Date(item.releaseAt).toLocaleString('fo-FO',{day:'numeric',month:'long',year:'numeric',hour:'2-digit',minute:'2-digit',timeZone:'Atlantic/Faroe'});
---
<Base title={item.title} description={item.description}>
  <article class="article">
    <a class="back" href="/">← Forsíða</a>
    <header><div class="eyebrow">{item.category} · Fyrsti lesari</div><h1>{item.title}</h1><p class="dek">{item.description}</p></header>
    <section class="prose">
      <p>Greinin verður almannakunngjørd {date}.</p>
      <p><strong>Tíð eftir til almenna útgávu:</strong></p>
      <p id="countdown" data-release={item.releaseAt} style="font:700 1.5rem Arial,sans-serif;color:var(--red)">Telur niður…</p>
      <p><a href={item.patreonUrl} target="_blank" rel="noopener noreferrer">Les greinina tíðliga á Patreon ↗</a></p>
    </section>
  </article>
</Base>
<script>
const node=document.getElementById('countdown');
if(node){
  const tick=()=>{
    const ms=new Date(node.dataset.release||'').getTime()-Date.now();
    if(ms<=0){node.textContent='Greinin verður almannakunngjørd skjótt.';return;}
    const m=Math.floor(ms/60000);
    node.textContent=Math.floor(m/1440)+' dagar · '+Math.floor(m%1440/60)+' tímar · '+m%60+' minuttir';
  };
  tick();setInterval(tick,60000);
}
</script>
