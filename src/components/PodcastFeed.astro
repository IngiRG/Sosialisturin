---
import feedData from '../data/patreon-podcast.json';
type Episode = {title:string;description:string;url:string;audio:string;date:string;preview:boolean};
const episodes = feedData as Episode[];
const feedUrl='https://www.patreon.com/public-rss/16895688?show=2493005';
const podcastUrl='https://www.patreon.com/sosialisturin';
const displayTitle=(title:string)=>title.replace(/^(?:(?:forhåndsvisning|forhåndsvisning:|preview|trailer)\s*[:–—-]?\s*)+/i,'').trim() || title;
---
<section class="podcast-feed" aria-label="Patreon poddvarp">
  <div class="podcast-top"><div><div class="eyebrow">Sosialisturin á Patreon</div><h2>Poddvarp</h2><p>Hoyr ókeypis poddvarpspartar og byrjanina av pørtum, sum krevja Patreon-limaskap.</p></div><a href={podcastUrl} target="_blank" rel="noopener noreferrer">Vitja Patreon ↗</a></div>
  {episodes.length ? <div class="podcast-list">{episodes.map((episode) => <article class="podcast-episode"><div class="episode-details"><div class="eyebrow">{episode.preview ? 'Hoyr byrjan' : 'Poddvarp'} · {new Date(episode.date).toLocaleDateString('fo-FO',{day:'numeric',month:'long',year:'numeric'})}</div><h3>{displayTitle(episode.title)}</h3>{episode.audio ? <audio controls preload="none" src={episode.audio} aria-label={'Hoyr: '+episode.title}></audio> : <p>Ljód er ikki tøkt í almenna RSS-streyminum.</p>}<a class="episode-link" href={episode.url || podcastUrl} target="_blank" rel="noopener noreferrer">{episode.preview ? 'Hoyr allan poddvarpspartin á Patreon ↗' : 'Hoyr poddvarpspartin á Patreon ↗'}</a></div></article>)}</div> : <p>Poddvarpspartarnir verða innlisnir úr almenna Patreon RSS-streyminum. <a href={feedUrl} target="_blank" rel="noopener noreferrer">Sí RSS-streymin ↗</a></p>}
</section>
<style>
.podcast-feed{padding:36px 0 20px;border-bottom:1px solid var(--ink)}.podcast-top{display:flex;justify-content:space-between;align-items:flex-start;gap:20px;margin-bottom:28px}.podcast-top h2{font:700 clamp(30px,4vw,48px)/1 Georgia,serif;margin:0 0 12px}.podcast-top p{max-width:640px;line-height:1.5}.podcast-top>a,.episode-link{font-size:13px;font-weight:800;text-decoration:underline;text-underline-offset:4px}.podcast-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px}.podcast-episode{border-top:3px solid var(--red);padding:20px 0 28px}.podcast-episode h3{font:700 27px/1.1 Georgia,serif;margin:0 0 12px}.podcast-episode p{line-height:1.5;color:var(--muted)}.podcast-episode audio{width:100%;margin:12px 0}.episode-link{display:inline-block;margin-top:12px;color:var(--red)}@media(max-width:750px){.podcast-list{grid-template-columns:1fr}.podcast-top{display:block}}
</style>
