---
import Base from '../layouts/Base.astro'; import PostCard from '../components/PostCard.astro'; import {getCollection} from 'astro:content';
export function getStaticPaths(){return ['tidindi','astodi','lesarabrov','poddvarp'].map(category=>({params:{category}}));}
import earlyData from '../data/early-access.json'; const early = earlyData as Array<{slug:string;title:string;description:string;releaseAt:string;patreonUrl:string;category:string;section?:string}>;
const map: Record<string,'Tíðindi'|'Ástøði'|'Lesarabrøv'|'Poddvarp'>={tidindi:'Tíðindi',astodi:'Ástøði',lesarabrov:'Lesarabrøv',poddvarp:'Poddvarp'}; const key=Astro.params.category ?? 'tidindi'; const label=map[key] ?? 'Tíðindi'; const all=await getCollection('posts'); const posts=all.filter(p=>label==='Lesarabrøv'?p.data.category==='Ástøði'&&p.data.section==='Lesarabrøv':label==='Ástøði'?p.data.category==='Ástøði'&&p.data.section!=='Lesarabrøv':p.data.category===label).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()); const base=import.meta.env.BASE_URL; const previews=early.filter(p=>new Date(p.releaseAt).getTime()>Date.now()&&(label==='Lesarabrøv'?p.category==='Ástøði'&&p.section==='Lesarabrøv':label==='Ástøði'?p.category==='Ástøði'&&p.section!=='Lesarabrøv':p.category===label)); const items=[...posts.map(post=>({kind:'post' as const,post,date:post.data.date.valueOf()})),...previews.map(preview=>({kind:'preview' as const,preview,date:new Date(preview.releaseAt).getTime()}))].sort((a,b)=>b.date-a.date);
---
<Base title={label}><header class="page-head"><h1>{label}</h1></header><section class="section"><div class="grid three">{items.map(item=>item.kind==='post'?<PostCard post={item.post}/>:<article class="card"><div class="eyebrow">{item.preview.section||item.preview.category}</div><div class="preview-lock" aria-label="Læst grein" title="Læst grein"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg></div><h2><a href={'/grein/'+item.preview.slug+'/'}>{item.preview.title}</a></h2><p>{item.preview.description}</p></article>)}</div></section></Base>
<style>.preview-lock{display:inline-flex;align-items:center;justify-content:center;background:#a51d25;color:#fff;border-radius:0;width:42px;height:42px;margin:.75rem 0 .4rem;box-shadow:0 3px 9px rgba(100,0,0,.18)}</style>
