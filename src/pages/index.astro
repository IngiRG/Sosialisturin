---
import Base from '../layouts/Base.astro'; import PostCard from '../components/PostCard.astro'; import {getCollection} from 'astro:content';
const posts=(await getCollection('posts')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()); const hero=posts.find(p=>p.data.featured)||posts[0]; const rest=posts.filter(p=>p.id!==hero?.id); const theory=posts.filter(p=>p.data.category==='Ástøði').slice(0,3); const media=posts.filter(p=>['Video','Ljóð'].includes(p.data.category)).slice(0,3); const base=import.meta.env.BASE_URL;
---
<Base><section class="edition"><span>Lorem ipsum dolor</span><span>Ipsum · {new Date().getFullYear()}</span></section>{hero&&<section class="hero"><div class="hero-copy"><div class="eyebrow">Lorem · {hero.data.category}</div><h1><a href={base+'grein/'+hero.id.replace(/\.(md|mdx)$/,'')+'/'}>{hero.data.title}</a></h1><p>{hero.data.description}</p><div class="meta">{hero.data.author}</div></div><a class="hero-art" href={base+'grein/'+hero.id.replace(/\.(md|mdx)$/,'')+'/'}><div class="art-placeholder"><span>S</span><i>01</i></div></a></section>}<section class="section"><div class="section-head"><h2>Lorem ipsum</h2><a href={base+'tidindi/'}>Dolor sit amet →</a></div><div class="grid three">{rest.slice(0,6).map(p=><PostCard post={p}/>)}</div></section><section class="manifesto"><span>Ástøði</span><h2>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</h2><a href={base+'astodi/'}>Consectetur adipiscing →</a></section><section class="section"><div class="grid three">{theory.map(p=><PostCard post={p}/>)}</div></section><section class="section dark"><div class="section-head"><h2>Lorem & ipsum</h2><a href={base+'video/'}>Dolor sit amet →</a></div><div class="grid three">{media.map(p=><PostCard post={p}/>)}</div></section></Base>