---
import Base from '../layouts/Base.astro'; import PostCard from '../components/PostCard.astro'; import {getCollection} from 'astro:content';
export function getStaticPaths(){return ['tidindi','astodi','lesarabrov','poddvarp'].map(category=>({params:{category}}));}
const map: Record<string,'Tíðindi'|'Ástøði'|'Lesarabrøv'|'Poddvarp'>={tidindi:'Tíðindi',astodi:'Ástøði',lesarabrov:'Lesarabrøv',poddvarp:'Poddvarp'}; const key=Astro.params.category ?? 'tidindi'; const label=map[key] ?? 'Tíðindi'; const all=await getCollection('posts'); const posts=all.filter(p=>label==='Lesarabrøv'?p.data.category==='Ástøði'&&p.data.section==='Lesarabrøv':label==='Ástøði'?p.data.category==='Ástøði'&&p.data.section!=='Lesarabrøv':p.data.category===label).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()); const base=import.meta.env.BASE_URL;
---
<Base title={label}><header class="page-head"><h1>{label}</h1>{(label==='Ástøði'||label==='Lesarabrøv')&&<nav class="subnav" aria-label="Ástøði og lesarabrøv"><a class={label==='Ástøði'?'active':''} href={base+'astodi/'}>Ástøði</a><a class={label==='Lesarabrøv'?'active':''} href={base+'lesarabrov/'}>Lesarabrøv</a></nav>}</header><section class="section"><div class="grid three">{posts.map(p=><PostCard post={p}/>)}</div></section></Base>