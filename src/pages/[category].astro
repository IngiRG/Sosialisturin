---
import Base from '../layouts/Base.astro'; import PostCard from '../components/PostCard.astro'; import {getCollection} from 'astro:content';
export function getStaticPaths(){return ['tidindi','astodi','poddvarp'].map(category=>({params:{category}}));}
const map: Record<string,'Tíðindi'|'Ástøði'|'Poddvarp'>={tidindi:'Tíðindi',astodi:'Ástøði',poddvarp:'Poddvarp'}; const key=Astro.params.category ?? 'tidindi'; const label=map[key] ?? 'Tíðindi'; const posts=(await getCollection('posts',p=>p.data.category===label)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
---
<Base title={label}><header class="page-head"><h1>{label}</h1></header><section class="section"><div class="grid three">{posts.map(p=><PostCard post={p}/>)}</div></section></Base>