---
import Base from '../layouts/Base.astro';
import early from '../data/early-access.json';
const upcoming = early.filter(item => new Date(item.releaseAt).getTime() > Date.now()).sort((a,b) => new Date(a.releaseAt).getTime()-new Date(b.releaseAt).getTime());
---
<Base title="Kemur skjótt" description="Greinar hjá Sosialistinum, sum koma skjótt.">
  <header class="page-head"><h1>Kemur skjótt</h1><p>Longri greinar, ið fyrst koma út til lesarar á Patreon og seinni verða tøkar fyri øll.</p></header>
  {upcoming.length===0 ? <p>Ongar greinar eru fráboðaðar í løtuni.</p> :
    <div class="grid three">
      {upcoming.map(item=><article class="early-card">
        <div class="eyebrow">{item.category} · Fyrsti lesari</div>
        <h2>{item.title}</h2>
        <p>{item.description}</p>
        <p class="early-label">Almenn útgáva: <time datetime={item.releaseAt}>{new Date(item.releaseAt).toLocaleString('fo-FO',{day:'numeric',month:'long',year:'numeric',hour:'2-digit',minute:'2-digit',timeZone:'Atlantic/Faroe'})}</time></p>
        <p class="early-countdown" data-release={item.releaseAt} aria-live="off">Telur niður…</p>
        <a class="early-link" href={item.patreonUrl} target="_blank" rel="noopener noreferrer">Les tíðliga á Patreon ↗</a>
      </article>)}
    </div>}
</Base>
<script>
  const update = () => {
    document.querySelectorAll<HTMLElement>('[data-release]').forEach(el => {
      const remaining = new Date(el.dataset.release || '').getTime() - Date.now();
      if (remaining <= 0) { el.textContent = 'Greinin verður nú almannakunngjørd.'; return; }
      const minutes = Math.floor(remaining / 60000);
      const days = Math.floor(minutes / 1440);
      const hours = Math.floor(minutes % 1440 / 60);
      el.textContent = days + ' dagar · ' + hours + ' tímar · ' + (minutes % 60) + ' minuttir';
    });
  };
  update();
  setInterval(update, 60000);
</script>
<style>
  .early-card { padding:1.25rem; border:1px solid var(--line); min-width:0; }
  .early-card h2 { overflow-wrap:anywhere; }
  .early-label { font-size:.85rem; color:var(--muted); }
  .early-countdown { font-family:Arial,sans-serif; font-weight:700; color:var(--red); }
  .early-link { display:inline-block; margin-top:.5rem; font:700 .88rem Arial,sans-serif; color:var(--red); }
</style>
