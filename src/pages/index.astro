---
import Base from '../layouts/Base.astro'; import PostCard from '../components/PostCard.astro'; import {getCollection} from 'astro:content';
import earlyData from '../data/early-access.json'; const early = earlyData as Array<{slug:string;title:string;description:string;releaseAt:string;patreonUrl:string;category:string;section?:string}>;
const previews=early.filter(item=>new Date(item.releaseAt).getTime()>Date.now());
const posts=(await getCollection('posts')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()); const hero=posts.find(p=>p.data.featured)||posts[0]; const rest=posts.filter(p=>p.id!==hero?.id); const base=import.meta.env.BASE_URL; const items=[...rest.map(post=>({kind:'post' as const,post,date:post.data.date.valueOf()})),...previews.map(preview=>({kind:'preview' as const,preview,date:new Date(preview.releaseAt).getTime()}))].sort((a,b)=>b.date-a.date);
---
<Base><section class="home-intro"><h1>Tín kelda til føroysk sosialistisk tíðindi, greiningar og ástøði, alt á einum staði.</h1></section>{hero&&<section class="hero"><div class="hero-copy"><div class="eyebrow">{hero.data.category}{hero.data.section&&<> · {hero.data.section}</>}</div><h1><a href={base+'grein/'+hero.id.replace(/\.(md|mdx)$/,'')+'/'}>{hero.data.title}</a></h1><p>{hero.data.description}</p><div class="meta">{hero.data.author}</div></div><a class="hero-art" href={base+'grein/'+hero.id.replace(/\.(md|mdx)$/,'')+'/'}><div class="art-placeholder"><span>S</span><i>01</i></div></a></section>}{items.length>0&&<section class="section"><div class="section-head"><h2>Seinastu greinar</h2></div><div class="grid three">{items.slice(0,6).map(item=>item.kind==='post'?<PostCard post={item.post}/>:<article class="card"><a class="card-art" href={base+'grein/'+item.preview.slug+'/'} aria-label={'Patreon: '+item.preview.title}><div class="art-placeholder"><span>S</span></div><span class="preview-clock-lock" aria-hidden="true"><svg viewBox="0 0 320 190" preserveAspectRatio="xMidYMid meet" fill="none" stroke="currentColor" stroke-linecap="square" stroke-linejoin="miter"><path d="M20 171L300 19" stroke-width="7" opacity=".9"/><circle cx="132" cy="108" r="57" stroke-width="8" fill="#f4f0e7"/><path d="M132 73v35l25 14" stroke-width="8"/><g transform="translate(219 12)"><rect x="0" y="43" width="77" height="65" fill="#f4f0e7" stroke-width="8"/><path d="M15 43V27a23 23 0 0 1 46 0v16" stroke-width="8"/></g></svg></span></a><div class="eyebrow">{item.preview.section||item.preview.category}</div><h2><a href={base+'grein/'+item.preview.slug+'/'}>{item.preview.title}</a></h2><p>{item.preview.description}</p></article>)}</div></section>}</Base>
<style>.preview-clock-lock{position:absolute;inset:0;z-index:2;display:flex;align-items:center;justify-content:center;color:#9d1c20;pointer-events:none}.preview-clock-lock svg{width:100%;height:100%;display:block}</style>
