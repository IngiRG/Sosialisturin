---
import Base from '../../layouts/Base.astro'; import early from '../../data/early-access.json'; import {getCollection,render} from 'astro:content';
export async function getStaticPaths(){const posts=await getCollection('posts');return [...posts.map(post=>({params:{slug:post.id.replace(/\.(md|mdx)$/,'')},props:{post}})),...early.filter(item=>!posts.some(p=>p.id.replace(/\.(md|mdx)$/,'')===item.slug)).map(item=>({params:{slug:item.slug},props:{preview:item}}))];} const {post,preview}=Astro.props; const rendered=post?await render(post):null; const Content=rendered?.Content; const d=post?.data; const date=d?.date.toLocaleDateString('fo-FO',{day:'numeric',month:'long',year:'numeric'}); const base=import.meta.env.BASE_URL; const path=d?.section==='Lesarabrøv'?'lesarabrov':d?.category==='Tíðindi'?'tidindi':d?.category==='Ástøði'?'astodi':'poddvarp'; const backLabel=d?.section==='Lesarabrøv'?'Lesarabrøv':d?.category;
---
<Base title={d?.title||preview.title} description={d?.description||preview.description}>{preview?<article class="article"><a class="back" href="/">← Forsíða</a><header><div class="eyebrow">{preview.category} · Fyrsti lesari</div><h1>{preview.title}</h1><p class="dek">{preview.description}</p></header><div class="prose"><p>Greinin verður almannakunngjørd seinni.</p><p><strong>Tíð eftir til almenna útgávu:</strong></p><p id="countdown" data-release={preview.releaseAt}>Telur niður…</p><p><a href={preview.patreonUrl} target="_blank" rel="noopener noreferrer">Les tíðliga á Patreon ↗</a></p></div></article>:<article class="article"><a class="back" href={base+path+'/'}>← {backLabel}</a><header><div class="eyebrow">{d.category}{d.section&&<> · {d.section}</>}</div><h1>{d.title}</h1><p class="dek">{d.description}</p><div class="byline"><strong>{d.author}</strong><span>{date}</span>{d.duration&&<span>{d.duration}</span>}</div></header>{d.mediaUrl&&d.category==='Poddvarp'&&<audio controls src={d.mediaUrl}></audio>}<div class="prose"><Content /></div><footer class="article-end"><span>S</span><p>Sosialisturin</p></footer></article>}</Base><script>const node=document.getElementById('countdown');if(node){const tick=()=>{const ms=new Date(node.dataset.release||'').getTime()-Date.now();if(ms<=0){node.textContent='Greinin verður almannakunngjørd skjótt.';return;}const m=Math.floor(ms/60000);node.textContent=Math.floor(m/1440)+' dagar · '+Math.floor(m%1440/60)+' tímar · '+m%60+' minuttir';};tick();setInterval(tick,60000);}</script>